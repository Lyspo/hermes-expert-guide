{
  "name": "hermes-expert-guide",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n content,next -c magenta,cyan \"content-collections watch\" \"next dev\"",
    "prebuild": "content-collections build",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "pnpm content && tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "links": "node scripts/check-links.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm og && pnpm build && pnpm search-index && pnpm links",
    "content": "content-collections build",
    "search-index": "node scripts/build-search.mjs",
    "og": "pnpm content && node scripts/build-og.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "motion": "12.42.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@content-collections/cli": "0.1.9",
    "@content-collections/core": "0.15.2",
    "@content-collections/mdx": "0.2.2",
    "@content-collections/next": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@shikijs/rehype": "4.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "linkinator": "^8.0.2",
    "pagefind": "1.5.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "0.29.0",
    "shiki": "4.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
